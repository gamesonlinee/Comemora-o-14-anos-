<script>
/* =========================================================
   RASPADINHA
========================================================= */
const scratchCanvas =
    document.getElementById("scratchCanvas");
const scratchCard =
    document.getElementById("scratchCard");
const scratchScreen =
    document.getElementById("scratchScreen");
const progressBar =
    document.getElementById("scratchProgressBar");
const ctx =
    scratchCanvas.getContext("2d");
let raspando = false;
let liberado = false;
let scratchCount = 0;
const totalRaspadas = 180;
let canvasWidth = 0;
let canvasHeight = 0;
/* =========================================================
   AJUSTA O CANVAS
========================================================= */
function configurarRaspadinha(){
    const rect =
        scratchCard.getBoundingClientRect();
    const dpr =
        window.devicePixelRatio || 1;
    canvasWidth = rect.width;
    canvasHeight = rect.height;
    scratchCanvas.width =
        canvasWidth * dpr;
    scratchCanvas.height =
        canvasHeight * dpr;
    scratchCanvas.style.width =
        canvasWidth + "px";
    scratchCanvas.style.height =
        canvasHeight + "px";
    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );
    /* Fundo da raspadinha */
    const grad =
        ctx.createLinearGradient(
            0,
            0,
            canvasWidth,
            canvasHeight
        );
    grad.addColorStop(
        0,
        "#cfcfcf"
    );
    grad.addColorStop(
        .35,
        "#8e8e8e"
    );
    grad.addColorStop(
        .55,
        "#d9d9d9"
    );
    grad.addColorStop(
        1,
        "#777"
    );
    ctx.fillStyle = grad;
    ctx.fillRect(
        0,
        0,
        canvasWidth,
        canvasHeight
    );
    /* Textura */
    for(let i = 0; i < 900; i++){
        const x =
            Math.random() * canvasWidth;
        const y =
            Math.random() * canvasHeight;
        const tamanho =
            Math.random() * 2 + .5;
        ctx.fillStyle =
            Math.random() > .5
                ? "rgba(255,255,255,.22)"
                : "rgba(0,0,0,.12)";
        ctx.fillRect(
            x,
            y,
            tamanho,
            tamanho
        );
    }
    /* Texto */
    ctx.save();
    ctx.fillStyle =
        "rgba(40,40,40,.65)";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font =
        "600 24px Poppins";
    ctx.fillText(
        "RASPE AQUI ❤️",
        canvasWidth / 2,
        canvasHeight / 2 - 12
    );
    ctx.font =
        "400 12px Poppins";
    ctx.fillStyle =
        "rgba(30,30,30,.55)";
    ctx.fillText(
        "Passe o dedo para descobrir",
        canvasWidth / 2,
        canvasHeight / 2 + 24
    );
    ctx.restore();
}
/* =========================================================
   POSIÇÃO DO TOQUE
========================================================= */
function obterPosicao(event){
    const rect =
        scratchCanvas.getBoundingClientRect();
    let clientX;
    let clientY;
    if(event.touches && event.touches.length){
        clientX =
            event.touches[0].clientX;
        clientY =
            event.touches[0].clientY;
    }else{
        clientX =
            event.clientX;
        clientY =
            event.clientY;
    }
    return {
        x:clientX - rect.left,
        y:clientY - rect.top
    };
}
/* =========================================================
   RASPAGEM
========================================================= */
function raspar(event){
    if(liberado){
        return;
    }
    event.preventDefault();
    const pos =
        obterPosicao(event);
    ctx.globalCompositeOperation =
        "destination-out";
    /* Tamanho da raspagem */
    ctx.beginPath();
    ctx.arc(
        pos.x,
        pos.y,
        27,
        0,
        Math.PI * 2
    );
    ctx.fill();
    /* Pequenas raspadas extras */
    for(let i = 0; i < 3; i++){
        const angulo =
            Math.random() * Math.PI * 2;
        const distancia =
            Math.random() * 20;
        const x =
            pos.x +
            Math.cos(angulo) * distancia;
        const y =
            pos.y +
            Math.sin(angulo) * distancia;
        ctx.beginPath();
        ctx.arc(
            x,
            y,
            12,
            0,
            Math.PI * 2
        );
        ctx.fill();
    }
    scratchCount++;
    const progresso =
        Math.min(
            (scratchCount / totalRaspadas) * 100,
            100
        );
    progressBar.style.width =
        progresso + "%";
    /*
       Libera automaticamente
       quando atingir aproximadamente 65%.
    */
    if(progresso >= 65){
        liberarSurpresa();
    }
}
/* =========================================================
   EVENTOS DE MOUSE
========================================================= */
scratchCanvas.addEventListener(
    "mousedown",
    function(event){
        raspando = true;
        raspar(event);
    }
);
scratchCanvas.addEventListener(
    "mousemove",
    function(event){
        if(raspando){
            raspar(event);
        }
    }
);
window.addEventListener(
    "mouseup",
    function(){
        raspando = false;
    }
);
/* =========================================================
   EVENTOS DE TOUCH - IPHONE
========================================================= */
scratchCanvas.addEventListener(
    "touchstart",
    function(event){
        raspando = true;
        raspar(event);
    },
    {passive:false}
);
scratchCanvas.addEventListener(
    "touchmove",
    function(event){
        if(raspando){
            raspar(event);
        }
    },
    {passive:false}
);
scratchCanvas.addEventListener(
    "touchend",
    function(){
        raspando = false;
    },
    {passive:false}
);
/* =========================================================
   LIBERAR O SITE
========================================================= */
function liberarSurpresa(){
    if(liberado){
        return;
    }
    liberado = true;
    /* Completa a barra */
    progressBar.style.width =
        "100%";
    /*
       Revela completamente
       a mensagem da raspadinha.
    */
    ctx.globalCompositeOperation =
        "destination-out";
    ctx.clearRect(
        0,
        0,
        canvasWidth,
        canvasHeight
    );
    /* Pequeno atraso para ela ver a mensagem */
    setTimeout(function(){
        const flash =
            document.createElement("div");
        flash.className =
            "unlock-flash";
        document.body.appendChild(flash);
        /* Chuva de corações */
        for(let i = 0; i < 80; i++){
            setTimeout(
                criarCoracao,
                i * 25
            );
        }
        /* Fecha a raspadinha */
        setTimeout(function(){
            scratchScreen.classList.add("hide");
            document.body.classList.remove(
                "locked"
            );
            document.body.classList.remove(
                "site-hidden"
            );
            /*
               Depois da transição,
               remove a tela da raspadinha
               do documento.
            */
            setTimeout(function(){
                scratchScreen.remove();
            },1100);
        },650);
    },500);
}
/* =========================================================
   CONTADOR
========================================================= */
function atualizarContador(){
    const dataFinal =
        new Date(
            "2026-09-16T00:00:00"
        ).getTime();
    const agora =
        new Date().getTime();
    const distancia =
        dataFinal - agora;
    if(distancia <= 0){
        document.getElementById(
            "dias"
        ).textContent = "❤️";
        document.getElementById(
            "horas"
        ).textContent = "❤️";
        document.getElementById(
            "minutos"
        ).textContent = "❤️";
        document.getElementById(
            "segundos"
        ).textContent = "❤️";
        return;
    }
    const dias =
        Math.floor(
            distancia /
            (1000 * 60 * 60 * 24)
        );
    const horas =
        Math.floor(
            (
                distancia %
                (1000 * 60 * 60 * 24)
            ) /
            (1000 * 60 * 60)
        );
    const minutos =
        Math.floor(
            (
                distancia %
                (1000 * 60 * 60)
            ) /
            (1000 * 60)
        );
    const segundos =
        Math.floor(
            (
                distancia %
                (1000 * 60)
            ) /
            1000
        );
    document.getElementById(
        "dias"
    ).textContent = dias;
    document.getElementById(
        "horas"
    ).textContent =
        String(horas).padStart(2,"0");
    document.getElementById(
        "minutos"
    ).textContent =
        String(minutos).padStart(2,"0");
    document.getElementById(
        "segundos"
    ).textContent =
        String(segundos).padStart(2,"0");
}
atualizarContador();
setInterval(
    atualizarContador,
    1000
);
/* =========================================================
   CORAÇÕES
========================================================= */
function criarCoracao(){
    const heart =
        document.createElement("div");
    heart.className =
        "heart";
    const tipos = [
        "❤️",
        "❤️",
        "💕",
        "💗",
        "💖",
        "❤️"
    ];
    heart.textContent =
        tipos[
            Math.floor(
                Math.random() *
                tipos.length
            )
        ];
    heart.style.left =
        Math.random() * 100 + "vw";
    heart.style.fontSize =
        (
            16 +
            Math.random() * 22
        ) + "px";
    heart.style.setProperty(
        "--x",
        (
            -80 +
            Math.random() * 160
        ) + "px"
    );
    const duracao =
        4.5 +
        Math.random() * 3;
    heart.style.animationDuration =
        duracao + "s";
    document.body.appendChild(
        heart
    );
    setTimeout(
        function(){
            heart.remove();
        },
        (duracao * 1000) + 500
    );
}
/* Mais corações durante a navegação */
setInterval(
    criarCoracao,
    1200
);
/* =========================================================
   BOTÃO REVIVER
========================================================= */
function reviverHistoria(){
    window.scrollTo({
        top:window.innerHeight,
        behavior:"smooth"
    });
    for(
        let i = 0;
        i < 18;
        i++
    ){
        setTimeout(
            criarCoracao,
            i * 90
        );
    }
}
/* =========================================================
   SURPRESA
========================================================= */
function mostrarSurpresa(){
    const surpresa =
        document.getElementById(
            "surpresa"
        );
    surpresa.classList.add(
        "show"
    );
    const musica =
        document.getElementById(
            "musica"
        );
    musica.play().catch(
        function(){
            console.log(
                "O navegador bloqueou o autoplay."
            );
        }
    );
    /*
       CHUVA DE CORAÇÕES ❤️
    */
    for(
        let i = 0;
        i < 120;
        i++
    ){
        setTimeout(
            function(){
                criarCoracao();
            },
            i * 55
        );
    }
}
/* =========================================================
   GALERIA / FOTO AMPLIADA
========================================================= */
const viewer =
    document.getElementById(
        "photoViewer"
    );
const viewerImg =
    document.getElementById(
        "photoViewerImg"
    );
document.querySelectorAll(
    ".gallery img, .memory-card img"
).forEach(
    function(img){
        img.addEventListener(
            "click",
            function(){
                viewerImg.src =
                    img.currentSrc ||
                    img.src;
                viewer.classList.add(
                    "show"
                );
                document.body.style.overflow =
                    "hidden";
            }
        );
    }
);
function fecharFoto(){
    viewer.classList.remove(
        "show"
    );
    viewerImg.src = "";
    document.body.style.overflow =
        "";
}
viewer.addEventListener(
    "click",
    function(event){
        if(
            event.target === viewer
        ){
            fecharFoto();
        }
    }
);
document.addEventListener(
    "keydown",
    function(event){
        if(
            event.key === "Escape"
        ){
            fecharFoto();
        }
    }
);
/* =========================================================
   CARREGAMENTO ANTECIPADO
========================================================= */
window.addEventListener(
    "load",
    function(){
        const fotos =
            document.querySelectorAll(
                ".gallery img"
            );
        fotos.forEach(
            function(img,index){
                setTimeout(
                    function(){
                        if(img.complete){
                            img.decode?.()
                                .catch(
                                    function(){}
                                );
                        }
                    },
                    index * 40
                );
            }
        );
    }
);
/* =========================================================
   MEMÓRIAS
========================================================= */
const cards =
    document.querySelectorAll(
        ".memory-card"
    );
const observer =
    new IntersectionObserver(
        function(entries){
            entries.forEach(
                function(entry){
                    if(
                        entry.isIntersecting
                    ){
                        entry.target.style.opacity =
                            "1";
                        entry.target.style.transform =
                            "translateY(0)";
                        observer.unobserve(
                            entry.target
                        );
                    }
                }
            );
        },
        {
            threshold:.08
        }
    );
cards.forEach(
    function(card){
        card.style.opacity =
            "0";
        card.style.transform =
            "translateY(20px)";
        card.style.transition =
            "opacity .7s ease, transform .7s ease";
        observer.observe(
            card
        );
    }
);
/* =========================================================
   INICIALIZA A RASPADINHA
========================================================= */
window.addEventListener(
    "load",
    function(){
        configurarRaspadinha();
    }
);
window.addEventListener(
    "resize",
    function(){
        /*
           Só recalcula se ainda
           estiver na tela inicial.
        */
        if(!liberado){
            configurarRaspadinha();
        }
    }
);
</script>
