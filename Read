<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}
html{
    scroll-behavior:smooth;
}
body{
    font-family:'Poppins',sans-serif;
    background:#080808;
    color:white;
    overflow-x:hidden;
}
/* =========================================================
   TELA INICIAL - RASPADINHA
========================================================= */
.scratch-screen{
    position:fixed;
    inset:0;
    z-index:50000;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    background:
        radial-gradient(
            circle at 50% 35%,
            rgba(255,70,120,.16),
            transparent 45%
        ),
        #080808;
    transition:
        opacity 1s ease,
        visibility 1s ease;
}
.scratch-screen.hide{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}
.scratch-content{
    width:min(100%,520px);
    text-align:center;
}
.scratch-top-heart{
    font-size:48px;
    margin-bottom:8px;
    animation:
        pulsar 1.5s ease-in-out infinite;
}
.scratch-content h1{
    font-family:'Dancing Script',cursive;
    font-size:clamp(48px,12vw,72px);
    line-height:1;
    margin-bottom:12px;
}
.scratch-subtitle{
    color:#ccc;
    font-size:15px;
    line-height:1.7;
    margin-bottom:28px;
}
.scratch-subtitle strong{
    color:white;
}
.scratch-card{
    position:relative;
    width:100%;
    max-width:420px;
    height:250px;
    margin:0 auto;
    border-radius:28px;
    overflow:hidden;
    background:
        linear-gradient(
            145deg,
            #191919,
            #0d0d0d
        );
    border:1px solid rgba(255,255,255,.15);
    box-shadow:
        0 25px 80px rgba(0,0,0,.7),
        0 0 50px rgba(255,60,120,.08);
    touch-action:none;
    user-select:none;
    -webkit-user-select:none;
}
.scratch-message{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    padding:25px;
    background:
        radial-gradient(
            circle,
            rgba(255,60,120,.20),
            transparent 65%
        );
}
.scratch-message .gift{
    font-size:48px;
    margin-bottom:8px;
}
.scratch-message h2{
    font-family:'Dancing Script',cursive;
    font-size:42px;
    line-height:1.1;
    margin-bottom:12px;
}
.scratch-message p{
    color:#ddd;
    font-size:14px;
    line-height:1.7;
}
.scratch-message strong{
    color:white;
}
#scratchCanvas{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    cursor:pointer;
    touch-action:none;
}
.scratch-instruction{
    margin-top:20px;
    font-size:14px;
    color:#aaa;
    animation:
        piscar 1.7s ease-in-out infinite;
}
.scratch-progress{
    width:min(100%,300px);
    height:5px;
    margin:15px auto 0;
    border-radius:10px;
    background:rgba(255,255,255,.08);
    overflow:hidden;
}
.scratch-progress-bar{
    width:0%;
    height:100%;
    border-radius:10px;
    background:linear-gradient(
        90deg,
        #ff3b70,
        #ff8fab
    );
    transition:width .2s ease;
}
.scratch-hint{
    margin-top:15px;
    font-size:11px;
    color:#666;
}
@keyframes pulsar{
    0%,100%{
        transform:scale(1);
    }
    50%{
        transform:scale(1.12);
    }
}
@keyframes piscar{
    0%,100%{
        opacity:.5;
    }
    50%{
        opacity:1;
    }
}
/* =========================================================
   ANIMAÇÃO DE ABERTURA
========================================================= */
body.locked{
    overflow:hidden;
}
body.site-hidden > *:not(.scratch-screen){
    visibility:hidden;
}
.unlock-flash{
    position:fixed;
    inset:0;
    z-index:49999;
    pointer-events:none;
    background:
        radial-gradient(
            circle,
            rgba(255,255,255,.95),
            rgba(255,60,120,.35),
            transparent 70%
        );
    opacity:0;
    animation:flashAbrir 1s ease forwards;
}
@keyframes flashAbrir{
    0%{
        opacity:0;
        transform:scale(.7);
    }
    40%{
        opacity:.9;
    }
    100%{
        opacity:0;
        transform:scale(1.5);
    }
}
/* =========================================================
   CORAÇÕES
========================================================= */
.heart{
    position:fixed;
    bottom:-40px;
    font-size:20px;
    pointer-events:none;
    z-index:9999;
    animation:subir linear forwards;
    will-change:transform,opacity;
    text-shadow:
        0 0 10px rgba(255,80,120,.5);
}
@keyframes subir{
    0%{
        transform:
            translateY(0)
            translateX(0)
            rotate(0deg)
            scale(.7);
        opacity:0;
    }
    10%{
        opacity:1;
    }
    50%{
        transform:
            translateY(-50vh)
            translateX(var(--x))
            rotate(180deg)
            scale(1);
        opacity:.9;
    }
    100%{
        transform:
            translateY(-115vh)
            translateX(calc(var(--x) * 1.5))
            rotate(360deg)
            scale(.5);
        opacity:0;
    }
}
/* =========================================================
   HERO
========================================================= */
.hero{
    min-height:100vh;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px 20px;
    overflow:hidden;
    background:
        linear-gradient(
            rgba(0,0,0,.48),
            rgba(0,0,0,.75)
        ),
        url("IMG_3285.png") center/cover no-repeat;
}
.hero::before{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(
            circle at center,
            rgba(255,60,120,.15),
            transparent 60%
        );
}
.hero-content{
    position:relative;
    z-index:2;
    max-width:900px;
}
.hero-small{
    font-size:18px;
    letter-spacing:3px;
    margin-bottom:15px;
    opacity:.9;
}
.hero h1{
    font-family:'Dancing Script',cursive;
    font-size:clamp(60px,12vw,120px);
    line-height:.95;
    margin-bottom:20px;
    text-shadow:
        0 5px 30px rgba(0,0,0,.8);
}
.hero-date{
    display:inline-block;
    padding:10px 24px;
    border-radius:30px;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.3);
    backdrop-filter:blur(10px);
    font-size:15px;
    margin:15px 0 25px;
}
.hero-text{
    max-width:700px;
    margin:auto;
    font-size:18px;
    line-height:1.8;
    color:#eee;
}
.btn{
    display:inline-block;
    margin-top:30px;
    padding:15px 28px;
    border:none;
    border-radius:40px;
    background:#fff;
    color:#111;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
    box-shadow:
        0 10px 35px rgba(255,255,255,.15);
}
.btn:hover{
    transform:
        translateY(-4px)
        scale(1.03);
}
/* =========================================================
   CONTADOR
========================================================= */
.countdown{
    margin-top:35px;
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}
.time-box{
    min-width:80px;
    padding:14px 10px;
    border-radius:15px;
    background:rgba(0,0,0,.45);
    border:1px solid rgba(255,255,255,.15);
    backdrop-filter:blur(8px);
}
.time-box strong{
    display:block;
    font-size:25px;
}
.time-box span{
    font-size:11px;
    opacity:.7;
}
/* =========================================================
   SEÇÕES
========================================================= */
section{
    padding:90px 20px;
    max-width:1200px;
    margin:auto;
}
.section-title{
    text-align:center;
    margin-bottom:55px;
}
.section-title h2{
    font-family:'Dancing Script',cursive;
    font-size:55px;
    margin-bottom:10px;
}
.section-title p{
    color:#aaa;
}
/* =========================================================
   14 ANOS
========================================================= */
.years{
    text-align:center;
}
.years-number{
    font-family:'Dancing Script',cursive;
    font-size:110px;
    line-height:1;
}
.years h3{
    font-size:28px;
    margin:10px 0 20px;
}
.years p{
    max-width:750px;
    margin:auto;
    color:#bbb;
    line-height:1.8;
}
/* =========================================================
   MEMÓRIAS
========================================================= */
.memory-grid{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}
.memory-card{
    position:relative;
    overflow:hidden;
    border-radius:20px;
    background:#151515;
    min-height:300px;
    box-shadow:
        0 10px 30px rgba(0,0,0,.3);
}
.memory-card img{
    width:100%;
    height:350px;
    object-fit:cover;
    display:block;
}
.memory-card::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(
            transparent 55%,
            rgba(0,0,0,.8)
        );
    pointer-events:none;
}
.memory-card-content{
    position:absolute;
    left:20px;
    right:20px;
    bottom:20px;
    z-index:2;
}
.memory-card-content h3{
    font-size:20px;
    margin-bottom:5px;
}
.memory-card-content p{
    font-size:13px;
    color:#ddd;
}
/* =========================================================
   GALERIA
========================================================= */
.gallery{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(210px,1fr));
    gap:15px;
    content-visibility:auto;
    contain-intrinsic-size:1000px;
}
.gallery img{
    width:100%;
    height:280px;
    object-fit:cover;
    border-radius:16px;
    cursor:pointer;
    display:block;
    transition:
        transform .3s ease,
        filter .3s ease;
}
.gallery img:hover{
    transform:scale(1.03);
    filter:brightness(1.1);
}
/* =========================================================
   CARTA
========================================================= */
.letter{
    max-width:850px;
    margin:auto;
    padding:45px 35px;
    border-radius:25px;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.08),
            rgba(255,255,255,.025)
        );
    border:1px solid rgba(255,255,255,.1);
    box-shadow:
        0 20px 60px rgba(0,0,0,.3);
}
.letter p{
    color:#ddd;
    line-height:2;
    margin-bottom:20px;
}
.signature{
    text-align:right;
    font-family:'Dancing Script',cursive;
    font-size:35px;
    margin-top:30px;
}
/* =========================================================
   FRASE
========================================================= */
.love-phrase{
    text-align:center;
    padding:100px 20px;
}
.love-phrase h2{
    font-family:'Dancing Script',cursive;
    font-size:
        clamp(45px,8vw,80px);
    line-height:1.1;
}
.love-phrase p{
    margin-top:25px;
    color:#aaa;
}
/* =========================================================
   SURPRESA
========================================================= */
.surprise{
    text-align:center;
}
.surprise-box{
    max-width:700px;
    margin:auto;
}
.surprise-message{
    display:none;
    margin-top:35px;
    padding:40px 30px;
    border-radius:25px;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);
    animation:
        aparecer .8s ease;
}
.surprise-message.show{
    display:block;
}
.surprise-message h3{
    font-family:'Dancing Script',cursive;
    font-size:48px;
    margin-bottom:20px;
}
.surprise-message p{
    color:#ddd;
    line-height:2;
}
@keyframes aparecer{
    from{
        opacity:0;
        transform:translateY(25px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}
/* =========================================================
   MÚSICA
========================================================= */
.music-box{
    text-align:center;
    margin-top:35px;
}
audio{
    width:min(100%,500px);
}
/* =========================================================
   FOOTER
========================================================= */
footer{
    text-align:center;
    padding:50px 20px;
    border-top:
        1px solid rgba(255,255,255,.08);
    color:#888;
}
footer strong{
    color:#ddd;
}
/* =========================================================
   VISUALIZADOR DE FOTOS
========================================================= */
.photo-viewer{
    position:fixed;
    inset:0;
    z-index:10000;
    background:rgba(0,0,0,.94);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}
.photo-viewer.show{
    display:flex;
}
.photo-viewer img{
    max-width:95vw;
    max-height:90vh;
    object-fit:contain;
    border-radius:12px;
    box-shadow:
        0 20px 80px rgba(0,0,0,.8);
}
.close-viewer{
    position:absolute;
    top:20px;
    right:25px;
    width:45px;
    height:45px;
    border:none;
    border-radius:50%;
    background:rgba(255,255,255,.12);
    color:white;
    font-size:25px;
    cursor:pointer;
}
/* =========================================================
   CELULAR
========================================================= */
@media(max-width:600px){
    section{
        padding:70px 15px;
    }
    .hero{
        padding:30px 18px;
    }
    .hero-small{
        font-size:14px;
        letter-spacing:2px;
    }
    .hero-text{
        font-size:15px;
        line-height:1.7;
    }
    .countdown{
        gap:7px;
    }
    .time-box{
        min-width:65px;
        padding:10px 7px;
    }
    .time-box strong{
        font-size:20px;
    }
    .section-title h2{
        font-size:45px;
    }
    .years-number{
        font-size:90px;
    }
    .letter{
        padding:30px 22px;
    }
    .gallery{
        grid-template-columns:repeat(2,1fr);
        gap:9px;
    }
    .gallery img{
        height:220px;
    }
    .memory-grid{
        grid-template-columns:1fr;
    }
    .memory-card img{
        height:400px;
    }
    .surprise-message h3{
        font-size:40px;
    }
    .scratch-screen{
        padding:
            20px
            18px
            calc(20px + env(safe-area-inset-bottom));
    }
    .scratch-top-heart{
        font-size:42px;
    }
    .scratch-content h1{
        font-size:54px;
    }
    .scratch-subtitle{
        font-size:14px;
        margin-bottom:22px;
    }
    .scratch-card{
        height:235px;
        border-radius:24px;
    }
    .scratch-message h2{
        font-size:38px;
    }
}
/* =========================================================
   REDUÇÃO DE MOVIMENTO
========================================================= */
@media(prefers-reduced-motion:reduce){
    *,
    *::before,
    *::after{
        animation-duration:.01ms !important;
        animation-iteration-count:1 !important;
        scroll-behavior:auto !important;
    }
}
</style>
